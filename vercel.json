{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,run.py,backend/**,runtime/**,examples/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
